{{ 'best-sellers.css' | asset_url | stylesheet_tag }}

{%- assign bs_collection = section.settings.collection -%}
{%- assign bs_limit = section.settings.products_to_show -%}

<div class="best-sellers color-{{ section.settings.color_scheme }}" data-best-sellers>
  <div class="page-width best-sellers__inner">

    <div class="best-sellers__header">
      <div class="best-sellers__heading-group">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="best-sellers__text">{{ section.settings.text }}</div>
        {% endif %}
      </div>

      {% if section.settings.show_arrows %}
        <div class="best-sellers__nav">
          <button type="button" class="best-sellers__arrow" data-best-sellers-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="best-sellers__arrow" data-best-sellers-next aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if bs_collection != blank and bs_collection.products.size > 0 %}
      <ul class="best-sellers__track" data-best-sellers-track>
        {% for product in bs_collection.products limit: bs_limit %}
          <li class="best-sellers__card" data-best-sellers-card>
            <a href="{{ product.url }}" class="best-sellers__media">
              {% if product.featured_image %}
                <img
                  class="best-sellers__image best-sellers__image--primary"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                          {{ product.featured_image | image_url: width: 600 }} 600w,
                          {{ product.featured_image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 70vw"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy">
              {% else %}
                <div class="best-sellers__placeholder"></div>
              {% endif %}

              {% if product.images.size > 1 %}
                <img
                  class="best-sellers__image best-sellers__image--hover"
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt=""
                  loading="lazy">
              {% endif %}

              {% if product.compare_at_price > product.price %}
                <span class="best-sellers__badge">Sale</span>
              {% endif %}
            </a>

            <div class="best-sellers__info">
              <a href="{{ product.url }}" class="best-sellers__title">{{ product.title }}</a>
              <p class="best-sellers__price">
                {% if product.compare_at_price > product.price %}
                  <span class="best-sellers__price--sale">{{ product.price | money }}</span>
                  <span class="best-sellers__price--compare">{{ product.compare_at_price | money }}</span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </p>
            </div>

            {% if product.available %}
              <button
                type="button"
                class="best-sellers__quick-add"
                data-best-sellers-quick-add
                data-product-id="{{ product.id }}"
                aria-label="Quick add {{ product.title | escape }}"
              >
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                <span>Quick add</span>
              </button>

              <script type="application/json" data-best-sellers-product-json="{{ product.id }}">
                {
                  "id": {{ product.id | json }},
                  "title": {{ product.title | json }},
                  "url": {{ product.url | json }},
                  "image": {{ product.featured_image | image_url: width: 400 | json }},
                  "options": {{ product.options_with_values | json }},
                  "variants": [
                    {% for variant in product.variants %}
                      {
                        "id": {{ variant.id | json }},
                        "title": {{ variant.title | json }},
                        "available": {{ variant.available | json }},
                        "price": {{ variant.price | json }},
                        "compare_at_price": {{ variant.compare_at_price | json }},
                        "options": {{ variant.options | json }},
                        "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                }
              </script>
            {% else %}
              <p class="best-sellers__sold-out">Sold out</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="best-sellers__empty">Select a collection to show best sellers here.</p>
    {% endif %}

  </div>
</div>

<!-- Quick add modal (shared, single instance per section) -->
<div class="best-sellers-modal" data-best-sellers-modal aria-hidden="true">
  <div class="best-sellers-modal__backdrop" data-best-sellers-modal-close></div>
  <div class="best-sellers-modal__dialog" role="dialog" aria-modal="true" aria-label="Quick add">
    <button type="button" class="best-sellers-modal__close" data-best-sellers-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <div class="best-sellers-modal__image-wrap">
      <img data-best-sellers-modal-image src="" alt="">
    </div>

    <div class="best-sellers-modal__info">
      <p class="best-sellers-modal__title" data-best-sellers-modal-title></p>
      <p class="best-sellers-modal__price" data-best-sellers-modal-price></p>

      <div class="best-sellers-modal__options" data-best-sellers-modal-options></div>

      <button type="button" class="best-sellers-modal__add" data-best-sellers-modal-add disabled>
        Add to Cart
      </button>
      <p class="best-sellers-modal__unavailable" data-best-sellers-modal-unavailable hidden>This combination is unavailable</p>
    </div>
  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-best-sellers]').forEach(function (section) {
      var track = section.querySelector('[data-best-sellers-track]');
      var prevBtn = section.querySelector('[data-best-sellers-prev]');
      var nextBtn = section.querySelector('[data-best-sellers-next]');
      if (!track) return;

      function cardStep() {
        var card = track.querySelector('[data-best-sellers-card]');
        if (!card) return track.clientWidth;
        var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || 0);
        return card.getBoundingClientRect().width + gap;
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScroll - 4;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          track.scrollBy({ left: -cardStep(), behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          track.scrollBy({ left: cardStep(), behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    });

    /* ---------- quick add modal (namespaced to best-sellers) ---------- */
    var modal = document.querySelector('[data-best-sellers-modal]');
    if (!modal) return;

    var modalImage = modal.querySelector('[data-best-sellers-modal-image]');
    var modalTitle = modal.querySelector('[data-best-sellers-modal-title]');
    var modalPrice = modal.querySelector('[data-best-sellers-modal-price]');
    var modalOptions = modal.querySelector('[data-best-sellers-modal-options]');
    var modalAddBtn = modal.querySelector('[data-best-sellers-modal-add]');
    var modalUnavailable = modal.querySelector('[data-best-sellers-modal-unavailable]');

    var currentProduct = null;
    var selections = {};

    function moneyFormat(cents) {
      if (window.Shopify && window.Shopify.formatMoney && window.moneyFormatString) {
        return window.Shopify.formatMoney(cents, window.moneyFormatString);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function findMatchingVariant() {
      if (!currentProduct) return null;
      return currentProduct.variants.find(function (variant) {
        return currentProduct.options.every(function (opt, i) {
          return variant.options[i] === selections[opt.name];
        });
      });
    }

    function isValueAvailable(optionIndex, value) {
      return currentProduct.variants.some(function (variant) {
        if (variant.options[optionIndex] !== value) return false;
        return currentProduct.options.every(function (opt, i) {
          if (i === optionIndex) return true;
          if (!selections[opt.name]) return true;
          return variant.options[i] === selections[opt.name];
        }) && variant.available;
      });
    }

    function renderOptions() {
      modalOptions.innerHTML = '';

      currentProduct.options.forEach(function (opt, optionIndex) {
        var group = document.createElement('div');
        group.className = 'best-sellers-modal__option-group';

        var label = document.createElement('p');
        label.className = 'best-sellers-modal__option-label';
        label.textContent = opt.name;
        group.appendChild(label);

        var swatchRow = document.createElement('div');
        swatchRow.className = 'best-sellers-modal__swatches';

        opt.values.forEach(function (value) {
          var swatch = document.createElement('button');
          swatch.type = 'button';
          swatch.className = 'best-sellers-modal__swatch';
          swatch.textContent = value;
          swatch.dataset.value = value;

          if (selections[opt.name] === value) swatch.classList.add('is-selected');
          if (!isValueAvailable(optionIndex, value)) swatch.classList.add('is-unavailable');

          swatch.addEventListener('click', function () {
            selections[opt.name] = value;
            renderOptions();
            updateSelectionState();
          });

          swatchRow.appendChild(swatch);
        });

        group.appendChild(swatchRow);
        modalOptions.appendChild(group);
      });
    }

    function updateSelectionState() {
      var variant = findMatchingVariant();

      if (variant) {
        modalPrice.innerHTML = variant.compare_at_price && variant.compare_at_price > variant.price
          ? '<span class="best-sellers-modal__price--sale">' + moneyFormat(variant.price) + '</span>' +
            '<span class="best-sellers-modal__price--compare">' + moneyFormat(variant.compare_at_price) + '</span>'
          : moneyFormat(variant.price);

        if (variant.image) modalImage.src = variant.image;

        modalAddBtn.dataset.variantId = variant.id;

        if (variant.available) {
          modalAddBtn.disabled = false;
          modalAddBtn.hidden = false;
          modalUnavailable.hidden = true;
        } else {
          modalAddBtn.disabled = true;
          modalAddBtn.hidden = true;
          modalUnavailable.hidden = false;
        }
      } else {
        modalAddBtn.disabled = true;
        modalAddBtn.hidden = true;
        modalUnavailable.hidden = false;
      }
    }

    function openModal(productData) {
      currentProduct = productData;
      selections = {};

      var defaultVariant = productData.variants.find(function (v) { return v.available; }) || productData.variants[0];
      if (defaultVariant) {
        productData.options.forEach(function (opt, i) {
          selections[opt.name] = defaultVariant.options[i];
        });
      }

      modalTitle.textContent = productData.title;
      modalImage.src = defaultVariant && defaultVariant.image ? defaultVariant.image : productData.image;
      modalImage.alt = productData.title;

      renderOptions();
      updateSelectionState();

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      currentProduct = null;
    }

    document.querySelectorAll('[data-best-sellers-quick-add]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var productId = btn.dataset.productId;
        var jsonEl = document.querySelector('[data-best-sellers-product-json="' + productId + '"]');
        if (!jsonEl) return;

        try {
          var productData = JSON.parse(jsonEl.textContent);
          openModal(productData);
        } catch (err) {
          console.error('Could not parse product data', err);
        }
      });
    });

    modal.querySelectorAll('[data-best-sellers-modal-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });

    modalAddBtn.addEventListener('click', function () {
      if (modalAddBtn.disabled || modalAddBtn.classList.contains('is-loading')) return;

      var variantId = modalAddBtn.dataset.variantId;
      var originalText = modalAddBtn.textContent;

      modalAddBtn.classList.add('is-loading');
      modalAddBtn.textContent = 'Adding...';

      fetch((window.Shopify ? window.Shopify.routes.root : '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(function () {
          modalAddBtn.textContent = 'Added ✓';
          modalAddBtn.classList.remove('is-loading');
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          setTimeout(function () {
            modalAddBtn.textContent = originalText;
            closeModal();
          }, 900);
        })
        .catch(function () {
          modalAddBtn.textContent = 'Error';
          modalAddBtn.classList.remove('is-loading');
          setTimeout(function () { modalAddBtn.textContent = originalText; }, 1500);
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Tip: create a \"Best Sellers\" collection sorted by Best selling"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
