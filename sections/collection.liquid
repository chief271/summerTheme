{% comment %}
This section is used in the collection template to render collection page
listing all products within a collection.

https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}


{% if section.settings.enable_quick_view %}
    {{ 'collection.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'collection-filters.js' | asset_url }}" defer></script>
{% endif %}



{{ 'quick-view.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
{% if section.settings.enable_quick_add %}
    {{ 'add-quick.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'add-quick.js' | asset_url }}" defer></script>
{% endif %}




<div class="collection page-width">
    
    <div class="collection-header">
        <h2 id="filter-btn">Filters</h2>
    </div>
    <div class="collection-inner">
        <collection-filters class="collection-filters" data-section-id="{{ section.id }}">
            <div class="collection-filters__heading">
                <h2>Filters</h2>
                <svg id="close-filter-btn" viewBox="-0.5 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path d="M3 21.32L21 3.32001" stroke="#000000" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                        <path d="M3 3.32001L21 21.32" stroke="#000000" stroke-width="1.5" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </g>
                </svg>
            </div>

            <div class="collection-filters__active-filters">
                {%- for filter in collection.filters -%}
                {%- for value in filter.active_values -%}
                <div class="collection-filters__active-filter-swatch">
                    <input data-remove-url="{{ value.url_to_remove }}" type="hidden" name="{{ filter.label | handle }}"
                        value="{{ value.value | handle }}">
                    <label for="{{ filter.label | handle }}-{{ value.value | handle }}"
                        class="collection-filters__active-filter-swatch-label">{{ value.label }} X</label>
                </div>
                {%- endfor -%}
                {%- endfor -%}
            </div>

            <div class="collection-filters__content">
                {% for filter in collection.filters %}
                <div class="collection-filter">
                    <accordion-toggle class="accordion">
                        <div class="accordion__header">
                            <span class="accordion__header-label">{{ filter.label }}</span>
                            <span class="accordion__toggle-icon">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12.5 6.5L8 11L3.5 6.5" stroke="black" stroke-width="1.5"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                        </div>
                        <div class="accordion__content">
                            <div class="collection-filter__options">
                                {% if filter.type == 'list' or filter.type == 'boolean' %}
                                <div class="collection-filter__options-list">
                                    {% for value in filter.values %}
                                    {%- if filter.label == 'Color' -%}
                                    <div
                                        class="collection-filter__option collection-filter__swatch collection-filter__swatch-color {% if value.count == 0 %}is-disabled{% endif %}">
                                        <input type="checkbox" {% if value.active %} checked {% endif %}
                                            id="{{ filter.label | handle }}-{{ value.value | handle }}" name="{{ filter.label | handle }}"
                                            value="{{ value.value | handle }}" data-add-url="{{ value.url_to_add }}"
                                            data-remove-url="{{ value.url_to_remove }}">
                                        <label for="{{ filter.label | handle }}-{{ value.value | handle }}" {% if value.swatch.color %}
                                            style="background-color: {{ value.swatch.color }}" {% elsif value.swatch.image %}
                                            style="background-image: url({{ value.swatch.image | image_url: width: 100 }})" {% else %}
                                            style="background-color: {{ value.label }}" {% endif %}></label>
                                    </div>
                                    {%- else -%}
                                    <div
                                        class="collection-filter__option collection-filter__swatch {% if value.count == 0 %}is-disabled{% endif %}">
                                        <input type="checkbox" {% if value.active %} checked {% endif %}
                                            id="{{ filter.label | handle }}-{{ value.value | handle }}" name="{{ filter.label | handle }}"
                                            value="{{ value.value | handle }}" data-add-url="{{ value.url_to_add }}"
                                            data-remove-url="{{ value.url_to_remove }}">
                                        <label for="{{ filter.label | handle }}-{{ value.value | handle }}">
                                            {{ value.label }}
                                        </label>
                                    </div>
                                    {%- endif -%}
                                    {% endfor %}
                                </div>
                                {% else %}
                                <div class="collection-filter__options-price-range">
                                    {% if filter.min_value.value %}
                                    {%- assign min_value = filter.min_value.value | divided_by: 100.0 -%}
                                    {% else %}
                                    {%- assign min_value = 0.0 -%}
                                    {% endif %}
                            
                                    {% if filter.max_value.value %}
                                    {%- assign max_value = filter.max_value.value | divided_by: 100.0 -%}
                                    {% else %}
                                    {%- assign max_value = filter.range_max | divided_by: 100.0 -%}
                                    {% endif %}
                            
                                    <div class="collection-filter__option">
                                        <div class="collection-filter__price-range">
                                            <input data-min-value type="range" id="{{ filter.min_value.param_name }}"
                                                name="{{ filter.min_value.param_name }}" min="0"
                                                max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}" value="{{ min_value }}"
                                                data-param="{{ filter.min_value.param_name }}" class="collection-filter__price-range-input-min">
                                            <input data-max-value type="range" id="{{ filter.max_value.param_name }}"
                                                name="{{ filter.max_value.param_name }}" min="0"
                                                max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}" value="{{ max_value }}"
                                                data-param="{{ filter.max_value.param_name }}" class="collection-filter__price-range-input-max">
                                            <div class="collection-filter__price-range-track"></div>
                                        </div>
                                        <div class="collection-filter__price-range-values">
                                            <span class="collection-filter__option-value" data-min-value-display>
                                                {{- min_value | times: 100 | money | split: '.' | first -}}
                                            </span>
                                            <span class="collection-filter__option-value" data-max-value-display>
                                                {{- max_value | times: 100 | money | split: '.' | first -}}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                            </div>

                        </div>
                    </accordion-toggle>
                </div>
                {% endfor %}
            </div>
        </collection-filters>

        <div class="collection-grid">
            <div class="collection-products" style="--grid-gap: {{ section.settings.grid_gap }}px">
                {% for product in collection.products %}
                <div class="collection-product">
                    <div class="collection-product__image-wrap">
                        {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 800 | image_tag: class: 'collection-product__image', loading:
                        'lazy', widths: '400,600,800' }}
                        {% endif %}
                    </div>
                
                    <div class="collection-product__content">
                        <a href="{{ product.url }}" class="collection-product__title">{{ product.title | escape }}</a>
                
                        {% if product.description != blank %}
                        <p class="collection-product__description">{{ product.description | strip_html | truncate: 60 }}</p>
                        {% endif %}
                
                        <div class="collection-product__footer">
                            <span class="collection-product__price">{{ product.price | money }}</span>
                
                            <div class="collection-product__actions">

                                <button type="button" class="collection-product__quick-view" data-quick-view data-product-handle="{{ product.handle }}"
                                    aria-label="Quick view {{ product.title | escape }}">
                                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                        <g id="SVGRepo_iconCarrier">
                                            <path
                                                d="M9 4.45962C9.91153 4.16968 10.9104 4 12 4C16.1819 4 19.028 6.49956 20.7251 8.70433C21.575 9.80853 22 10.3606 22 12C22 13.6394 21.575 14.1915 20.7251 15.2957C19.028 17.5004 16.1819 20 12 20C7.81811 20 4.97196 17.5004 3.27489 15.2957C2.42496 14.1915 2 13.6394 2 12C2 10.3606 2.42496 9.80853 3.27489 8.70433C3.75612 8.07914 4.32973 7.43025 5 6.82137"
                                                stroke="#1C274C" stroke-width="1.5" stroke-linecap="round"></path>
                                            <path
                                                d="M15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z"
                                                stroke="#1C274C" stroke-width="1.5"></path>
                                        </g>
                                    </svg>
                                </button>
                                {% if section.settings.enable_quick_add %}
                                <button type="button" class="collection-product__cart" data-quick-add data-product-handle="{{ product.handle }}">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                        <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                    </svg>
                                </button>
                                {% endif %}
                                
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
                {% comment %} quick View  {% endcomment %}
                {% if section.settings.enable_quick_view %}
                <div class="quick-view-modal" data-quick-view-modal>
                
                    <div class="quick-view-modal__overlay" data-quick-view-close></div>
                
                    <div class="quick-view-modal__content">
                
                        <button type="button" class="quick-view-modal__close" data-quick-view-close>
                            ×
                        </button>
                
                        <div class="quick-view-modal__product">
                
                            <div class="quick-view-modal__media">
                
                                <img src="" alt="" data-quick-view-image>
                
                            </div>
                
                            <div class="quick-view-modal__details">
                
                                <h2 data-quick-view-title></h2>
                
                                <p class="quick-view-modal__price" data-quick-view-price></p>
                
                                <div class="quick-view-modal__description" data-quick-view-description></div>
                
                                <div class="quick-view-modal__options" data-quick-view-options></div>
                
                
                
                
                
                                <a href="#" class="quick-view-modal__full-product" data-quick-view-link>
                                    View full product
                                </a>
                
                            </div>
                
                        </div>
                
                    </div>
                
                </div>
                {% endif %}
                
                {% if section.settings.enable_quick_add %}
                    <div class="quick-add-modal" data-quick-add-modal>
                    
                        <div class="quick-add-modal__overlay" data-quick-add-close></div>
                    
                        <div class="quick-add-modal__content">
                    
                            <button type="button" class="quick-add-modal__close" data-quick-add-close>
                                ×
                            </button>
                    
                            <div class="quick-add-modal__product">
                    
                                <img src="" alt="" data-quick-add-image>
                    
                                <div>
                                    <h2 data-quick-add-title></h2>
                                    <p data-quick-add-price></p>
                                </div>
                    
                            </div>
                    
                            <div class="quick-add-modal__options" data-quick-add-options></div>
                    
                            <button type="button" class="quick-add-modal__submit" data-quick-add-submit>
                                Add to cart
                            </button>
                    
                        </div>
                    
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>


{% schema %}
{
"name": "Collection",
"settings": [
    {
    "type": "checkbox",
    "id": "enable_quick_add",
    "label": "Enable quick add",
    "default": true
    },
    {
    "type": "checkbox",
    "id": "enable_quick_view",
    "label": "Enable quick view",
    "default": true
    },
{
"type": "range",
"id": "grid_gap",
"label": "Grid Gap",
"min": 0,
"max": 50,
"step": 5,
"unit": "px",
"default": 10
}
],
"presets": [
    {
        "name": "Collection"
    }
]
}
{% endschema %}