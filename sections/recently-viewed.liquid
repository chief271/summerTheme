<div class="page-width recently-viewed" id="recently-viewed" data-limit="{{ section.settings.products_limit }}"
    data-current="{{ product.id }}">

    {% if section.settings.show_heading %}
    <h2 class="recently-viewed__heading">
        {{ section.settings.heading }}
    </h2>
    {% endif %}

    <div class="recently-viewed__grid" id="recently-viewed-grid"
        style="--rv-cols: {{ section.settings.columns_desktop }};"></div>

</div>

<style>
    .recently-viewed {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        padding-left: 3rem;
        padding-right: 3rem;
        background: {{ section.settings.background_color }};
    }

    .recently-viewed .recently-viewed__heading {
        margin: 0 0 20px;
        color: {{ section.settings.heading_color }};
        font-size: {{ section.settings.heading_size }}px;
        font-weight: 600;
    }

    .recently-viewed .recently-viewed__grid {
        display: grid;
        grid-template-columns: repeat(var(--rv-cols), minmax(0, 1fr));
        gap: {{ section.settings.card_gap }}px;
    }

    .recently-viewed .recently-viewed__card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background: #fff;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    {% if section.settings.show_hover_effect %}
    .recently-viewed  .recently-viewed__card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .recently-viewed .recently-viewed__card:hover .recently-viewed__image {
        transform: scale(1.04);
    }
    {% endif %}

    .recently-viewed  .recently-viewed__image-wrapper {
        display: block;
        width: 100%;
        aspect-ratio: {{ section.settings.image_ratio }};
        overflow: hidden;
        background: #f5f5f5;
    }

    .recently-viewed  .recently-viewed__image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .recently-viewed  .recently-viewed__info {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding-top: 12px;
    }

    .recently-viewed  .recently-viewed__product-title {
        margin: 0;
        color: #111;
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .recently-viewed .recently-viewed__price {
        margin: 0;
        color: #111;
        font-size: 0.85rem;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .recently-viewed {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .recently-viewed  .recently-viewed__grid {
            grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
        }
    }
</style>

<script>
(() => {

    const STORAGE_KEY = 'recentlyViewed';
    const MAX_STORE = 12;

    /*
    ========================================
    SAVE CURRENT PRODUCT (only on product pages)
    ========================================
    */

    {% if product %}
    const currentProduct = {
        id: {{ product.id | json }},
        title: {{ product.title | json }},
        price: {{ product.price | json }},
        url: {{ product.url | json }},
        image: {{ product.featured_image | image_url: width: 600 | json }}
    };

    let storedProducts = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');

    // Remove product if it already exists
    storedProducts = storedProducts.filter(p => p.id !== currentProduct.id);

    // Put current product first
    storedProducts.unshift(currentProduct);

    // Save latest products
    localStorage.setItem(STORAGE_KEY, JSON.stringify(storedProducts.slice(0, MAX_STORE)));
    {% endif %}

    /*
    ========================================
    RENDER PRODUCTS
    ========================================
    */

    function renderRecentlyViewed() {

        const section = document.querySelector('#recently-viewed');
        const grid = document.querySelector('#recently-viewed-grid');

        if (!section || !grid) return;

        const limit = parseInt(section.dataset.limit, 10) || 4;
        const currentId = parseInt(section.dataset.current, 10);

        const products = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');

        const productsToShow = products
            .filter(product => product.id !== currentId)
            .slice(0, limit);

        // Hide section if empty
        if (productsToShow.length === 0) {
            section.style.display = 'none';
            return;
        }

        productsToShow.forEach(product => {

            const card = document.createElement('div');
            card.className = 'recently-viewed__card';

            card.innerHTML = `
                <a href="${product.url}" class="recently-viewed__image-wrapper">
                    <img
                        src="${product.image}"
                        alt="${product.title}"
                        class="recently-viewed__image"
                        loading="lazy"
                    >
                </a>

                <div class="recently-viewed__info">
                    <p class="recently-viewed__product-title">${product.title}</p>
                    <p class="recently-viewed__price">${formatMoney(product.price)}</p>
                </div>
            `;

            grid.appendChild(card);
        });
    }

    /*
    ========================================
    MONEY
    ========================================
    */

    function formatMoney(cents) {
        return new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD'
        }).format(cents / 100);
    }

    /*
    ========================================
    INIT
    ========================================
    */

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderRecentlyViewed);
    } else {
        renderRecentlyViewed();
    }

})();
</script>

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (px)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "info": "How many recently viewed products to display."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_hover_effect",
      "label": "Enable hover lift effect",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed"
    }
  ]
}
{% endschema %}
