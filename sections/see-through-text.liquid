
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-cta-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: {{ block.settings.block_height }}px;
    overflow: hidden;
    {% if block.settings.fill_image %}
      background-image: url('{{ block.settings.fill_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% else %}
      background-color: #f4f4f4;
    {% endif %}
  }

  .ai-image-text-cta__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: {{ block.settings.text_alignment }};
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.section_padding }}px 20px;
    text-align: {{ block.settings.text_alignment }};
    {% if block.settings.fill_image %}
      background: {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  .ai-image-text-cta__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.1;
    margin: 0;
    max-width: 900px;
    {% if block.settings.fill_image %}
      /* punches a transparent hole through the overlay above,
         revealing the crisp, untinted photo behind it */
      mix-blend-mode: destination-out;
      color: #000000;
    {% else %}
      color: {{ block.settings.heading_color }};
    {% endif %}
  }

  .ai-image-text-cta__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    max-width: 600px;
    position: relative;
  }

  .ai-image-text-cta__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    position: relative;
  }

  .ai-image-text-cta__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-image-text-cta__placeholder-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
  }

  .ai-image-text-cta__placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: 400px;
    height: auto;
    background-color: #f4f4f4;
    border-radius: 8px;
    padding: 40px;
  }

  .ai-image-text-cta__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    opacity: 0.3;
  }

  .ai-image-text-cta__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-cta-{{ ai_gen_id }} {
      height: calc({{ block.settings.block_height }}px * 0.75);
    }

    .ai-image-text-cta__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .ai-image-text-cta__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.85);
    }

    .ai-image-text-cta__button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-cta__overlay-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-image-text-cta__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% elsif block.settings.fill_image == blank %}
      <div class="ai-image-text-cta__placeholder-wrapper-{{ ai_gen_id }}">
        <div class="ai-image-text-cta__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
        <div class="ai-image-text-cta__empty-state-{{ ai_gen_id }}">
          Add an image fill and heading text
        </div>
      </div>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-image-text-cta__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </p>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-image-text-cta__button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "See Through text CTA",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "BOLD STATEMENT"
    },
    {
      "type": "image_picker",
      "id": "fill_image",
      "label": "Background image",
      "info": "The heading text becomes a see-through cutout revealing this image; the rest of the block is tinted."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Size",
      "default": 120
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "900"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Fallback color",
      "info": "Used only when no background image is set.",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading text",
      "default": "Discover our latest collection"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Content spacing",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "block_height",
      "label": "Block height",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "See Through text CTA"
    }
  ]
}
{% endschema %}
