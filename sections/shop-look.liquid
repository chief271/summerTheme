{{ 'shop-the-look.css' | asset_url | stylesheet_tag }}

<div class="shop-look page-width">
  <div class="shop_header">
    <h2>{{ section.settings.header }}</h2>
    {% if section.settings.desc != blank %}
      <div class="shop_desc">{{ section.settings.desc }}</div>
    {% endif %}
  </div>

  <div class="shop-look__grid">
    <!-- LEFT -->
    <div class="shop-look__left">
      <button type="button" class="look-slider__button look-slider__button--prev" aria-label="Previous look">
        <svg style="width: 24px; height:24px;" viewBox="0 0 24 24" fill="#000"><polyline fill="none" stroke="#000" stroke-width="2" points="7 2 17 12 7 22" transform="matrix(-1 0 0 1 24 0)"></polyline></svg>
      </button>

      <div class="look-slider">
        {% for block in section.blocks %}
          <div class="look-slide{% if forloop.first %} is-active{% endif %}" data-look-slide {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}

            {% if block.settings.product_1 %}
              <button class="look-dot is-active" data-dot data-slide="{{ forloop.index0 }}" data-product="1" style="left:{{ block.settings.product_1_x }}%; top:{{ block.settings.product_1_y }}%;">
                <span></span>
              </button>
            {% endif %}

            {% if block.settings.product_2 %}
              <button class="look-dot" data-dot data-slide="{{ forloop.index0 }}" data-product="2" style="left:{{ block.settings.product_2_x }}%; top:{{ block.settings.product_2_y }}%;">
                <span></span>
              </button>
            {% endif %}

            {% assign product_1 = block.settings.product_1 %}
            {% assign product_2 = block.settings.product_2 %}

            <script type="application/json" class="look-slide-data">
              {
                "products": [
                  {% assign added = false %}
                  {% if product_1 %}
                    {
                      "id": {{ product_1.selected_or_first_available_variant.id | default: null }},
                      "title": {{ product_1.title | json }},
                      "url": {{ product_1.url | json }},
                      "image": {% if product_1.featured_image %}{{ product_1.featured_image | image_url: width: 500 | json }}{% else %}""{% endif %},
                      "price": {{ product_1.price | money | json }},
                      "compare_at_price": {{ product_1.compare_at_price | money | json }},
                      "variants": {{ product_1.variants | json }}
                    }
                    {% assign added = true %}
                  {% endif %}

                  {% if product_2 %}
                    {% if added %},{% endif %}
                    {
                      "id": {{ product_2.selected_or_first_available_variant.id | default: null }},
                      "title": {{ product_2.title | json }},
                      "url": {{ product_2.url | json }},
                      "image": {% if product_2.featured_image %}{{ product_2.featured_image | image_url: width: 500 | json }}{% else %}""{% endif %},
                      "price": {{ product_2.price | money | json }},
                      "compare_at_price": {{ product_2.compare_at_price | money | json }},
                      "variants": {{ product_2.variants | json }}
                    }
                  {% endif %}
                ]
              }
            </script>
          </div>
        {% endfor %}
      </div>

      <button type="button" class="look-slider__button look-slider__button--next" aria-label="Next look">
        <svg fill="#000" height="24px" width="24px" viewBox="0 0 24 24"><polygon points="6.8,23.7 5.4,22.3 15.7,12 5.4,1.7 6.8,0.3 18.5,12 "></polygon></svg>
      </button>
    </div>

    <!-- RIGHT -->
    <div class="shop-look__right">
      <div class="look-product-card" data-look-card>
        <div class="look-product-card__image">
          <img src="" alt="" data-product-image>
        </div>

        <div class="look-product-card__content">
          <h3><a href="" data-product-title></a></h3>
          <div class="look-product-price" data-product-price></div>

          <button type="button" class="button button--full-width" data-add-cart-quick>
            <span>Quick Add</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Custom Independent Modal Element -->
<shop-look-modal class="shop-look-modal">
  <div class="shop-look-modal__overlay" data-modal>
    <div class="shop-look-modal__dialog">
      <button type="button" class="shop-look-modal__close" data-modal-close aria-label="Close">&times;</button>
      <div class="shop-look-modal__body" data-modal-content></div>
    </div>
  </div>
</shop-look-modal>

<script type="application/json" class="look-slide-data">
  {
    "products": [
      {% assign added = false %}
      {% if product_1 %}
        {
          "id": {{ product_1.selected_or_first_available_variant.id | default: null }},
          "title": {{ product_1.title | json }},
          "url": {{ product_1.url | json }},
          "image": {% if product_1.featured_image %}{{ product_1.featured_image | image_url: width: 500 | json }}{% else %}""{% endif %},
          "price": {{ product_1.price | money | json }},
          "compare_at_price": {{ product_1.compare_at_price | money | json }},
          "options": {{ product_1.options | json }},
          "variants": {{ product_1.variants | json }}
        }
        {% assign added = true %}
      {% endif %}

      {% if product_2 %}
        {% if added %},{% endif %}
        {
          "id": {{ product_2.selected_or_first_available_variant.id | default: null }},
          "title": {{ product_2.title | json }},
          "url": {{ product_2.url | json }},
          "image": {% if product_2.featured_image %}{{ product_2.featured_image | image_url: width: 500 | json }}{% else %}""{% endif %},
          "price": {{ product_2.price | money | json }},
          "compare_at_price": {{ product_2.compare_at_price | money | json }},
          "options": {{ product_2.options | json }},
          "variants": {{ product_2.variants | json }}
        }
      {% endif %}
    ]
  }
</script>

<script src="{{ 'quick-add-handler.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'shop-the-look.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Shop Look",
  "settings": [
    { "type": "text", "id": "header", "label": "Section Header", "default": "Shop The Look" },
    { "type": "textarea", "id": "desc", "label": "Section Description", "default": "Choose Your Favorite Article" }
  ],
  "blocks": [
    {
      "type": "look_slide",
      "name": "Look Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Look Image" },
        { "type": "product", "id": "product_1", "label": "First Product" },
        { "type": "range", "id": "product_1_x", "label": "Product 1 X", "min": 0, "max": 100, "step": 1, "default": 30, "unit": "%" },
        { "type": "range", "id": "product_1_y", "label": "Product 1 Y", "min": 0, "max": 100, "step": 1, "default": 40, "unit": "%" },
        { "type": "product", "id": "product_2", "label": "Second Product" },
        { "type": "range", "id": "product_2_x", "label": "Product 2 X", "min": 0, "max": 100, "step": 1, "default": 70, "unit": "%" },
        { "type": "range", "id": "product_2_y", "label": "Product 2 Y", "min": 0, "max": 100, "step": 1, "default": 60, "unit": "%" }
      ]
    }
  ],
  "presets": [
    { "name": "Shop the Look" }
  ]
}
{% endschema %}