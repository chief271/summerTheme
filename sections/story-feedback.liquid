{{ 'story-feedback.css' | asset_url | stylesheet_tag }}

<div
  class="story-feedback color-{{ section.settings.color_scheme }}"
  style="--story-feedback-padding-top: {{ section.settings.padding_top }}px; --story-feedback-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="story-feedback__header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div
      class="story-feedback__viewer"
      data-story-viewer
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    >

      {% if section.blocks.size > 1 %}
        <div class="story-feedback__progress" data-story-progress>
          {% for block in section.blocks %}
            {% if block.type == "story" %}
              <div class="story-feedback__progress-bar" data-story-progress-bar data-index="{{ forloop.index0 }}">
                <span class="story-feedback__progress-fill" data-story-progress-fill></span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="story-feedback__header-row">
        {% if section.settings.avatar != blank %}
          <img
            class="story-feedback__avatar"
            src="{{ section.settings.avatar | image_url: width: 80 }}"
            alt=""
            width="32" height="32">
        {% endif %}
        <span class="story-feedback__account-name">{{ section.settings.account_name | default: shop.name }}</span>
      </div>

      <div class="story-feedback__slides">
        {% for block in section.blocks %}
          {% if block.type == "story" %}
            <div
              class="story-feedback__slide{% if forloop.first %} is-active{% endif %}"
              data-story-slide
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 1080 }}"
                  srcset="{{ block.settings.image | image_url: width: 540 }} 540w,
                          {{ block.settings.image | image_url: width: 1080 }} 1080w",
                  sizes="(min-width: 750px) 400px, 100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              {% else %}
                <div class="story-feedback__placeholder"></div>
              {% endif %}

              {% if block.settings.customer_name != blank or block.settings.quote != blank %}
                <div class="story-feedback__caption">
                  {% if block.settings.quote != blank %}
                    <p class="story-feedback__quote">{{ block.settings.quote }}</p>
                  {% endif %}
                  {% if block.settings.customer_name != blank %}
                    <p class="story-feedback__customer">— {{ block.settings.customer_name }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <button type="button" class="story-feedback__tap-zone story-feedback__tap-zone--prev" data-story-prev aria-label="Previous"></button>
        <button type="button" class="story-feedback__tap-zone story-feedback__tap-zone--next" data-story-next aria-label="Next"></button>
      {% endif %}

    </div>

  </div>
</div>

<script>
  (function () {
    document.querySelectorAll('[data-story-viewer]').forEach(function (root) {
      var slides = root.querySelectorAll('[data-story-slide]');
      var bars = root.querySelectorAll('[data-story-progress-bar]');
      var fills = root.querySelectorAll('[data-story-progress-fill]');
      var prevBtn = root.querySelector('[data-story-prev]');
      var nextBtn = root.querySelector('[data-story-next]');
      var current = 0;
      var timer = null;
      var autoplay = root.dataset.autoplay === 'true';
      var speed = parseInt(root.dataset.autoplaySpeed, 10) || 4000;

      if (slides.length === 0) return;

      function setFillState(index) {
        fills.forEach(function (fill, i) {
          fill.classList.remove('is-filling');
          fill.style.animationDuration = '';
          if (i < index) {
            fill.style.width = '100%';
          } else if (i === index) {
            fill.style.width = '';
            void fill.offsetWidth;
            fill.style.animationDuration = speed + 'ms';
            fill.classList.add('is-filling');
          } else {
            fill.style.width = '0%';
          }
        });
      }

      function goTo(index) {
        if (index >= slides.length) index = 0;
        if (index < 0) index = slides.length - 1;

        slides[current].classList.remove('is-active');
        bars[current] && bars[current].classList.remove('is-active');

        current = index;

        slides[current].classList.add('is-active');
        bars[current] && bars[current].classList.add('is-active');
        setFillState(current);
      }

      function next() { goTo(current + 1); }
      function prev() { goTo(current - 1); }

      function startAutoplay() {
        if (!autoplay) return;
        stopAutoplay();
        timer = setInterval(next, speed);
      }

      function stopAutoplay() {
        if (timer) clearInterval(timer);
      }

      nextBtn && nextBtn.addEventListener('click', function () { next(); startAutoplay(); });
      prevBtn && prevBtn.addEventListener('click', function () { prev(); startAutoplay(); });

      bars.forEach(function (bar) {
        bar.addEventListener('click', function () {
          goTo(parseInt(bar.dataset.index, 10));
          startAutoplay();
        });
      });

      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);

      setFillState(0);
      startAutoplay();
    });
  })();
</script>

{% schema %}
{
  "name": "Story Feedback",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "account_name",
      "label": "Account name shown on story",
      "info": "Defaults to shop name if left blank"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar / logo"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Portrait images work best (e.g. 1080x1920)"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote / feedback text",
          "info": "Leave blank if the feedback is already visible in the image (e.g. a review screenshot)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Story Feedback",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}