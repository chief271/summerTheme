<article class="premium-card">

  <!-- Media -->
  <div class="premium-card__media">

    {% render 'card-product-badges',
      card_product: product
    %}

    <a href="{{ product.url }}" class="premium-card__link">

      {% render 'card-product-media',
        card_product: product,
        media_aspect_ratio: media_aspect_ratio,
        show_secondary_image: show_secondary_image
      %}

    </a>

  </div>

  <!-- Content -->
  <div class="premium-card__content">

    {% if show_vendor %}
      <span class="premium-card__vendor">
        {{ product.vendor }}
      </span>
    {% endif %}

    <h3 class="premium-card__title">
      <a href="{{ product.url }}">
        {{ product.title | escape }}
      </a>
    </h3>

    {% if show_rating %}
      {% render 'rating',
        product: product
      %}
    {% endif %}

    <div class="premium-card__price">
      {% render 'price',
        product: product,
        use_variant: false,
        price_class: ''
      %}
    </div>

    {% if enable_quick_add %}

      {% if product.available == false %}

        <button
          class="button button--full-width"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>

      {% elsif product.has_only_default_variant %}

        {% render 'quick-add',
          product: product,
          section_id: section.id
        %}

      {% else %}

        <button
          class="button button--full-width premium-card__choose-options"
          data-product-handle="{{ product.handle }}"
        >
          {{ 'products.product.choose_options' | t }}
        </button>

      {% endif %}

    {% endif %}

  </div>

</article>